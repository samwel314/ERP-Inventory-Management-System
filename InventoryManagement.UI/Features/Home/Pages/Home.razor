@page "/"

<PageTitle>Home</PageTitle>
<div class="container-fluid px-4">
    <h1 class="mt-4">Dashboard</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Samuel ERP System Overview</li>
    </ol>

    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-primary text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="me-3">
                            <div class="text-white-50 small">Total Products</div>
                            <div class="text-lg fw-bold">1,234</div>
                        </div>
                        <i class="oi oi-box fs-1 opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small">
                    <a class="text-white stretched-link" href="products">View Details</a>
                    <div class="text-white"><i class="oi oi-chevron-right"></i></div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-success text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="me-3">
                            <div class="text-white-50 small">Categories</div>
                            <div class="text-lg fw-bold">48</div>
                        </div>
                        <i class="oi oi-list-rich fs-1 opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small">
                    <a class="text-white stretched-link" href="categories">View Categories</a>
                    <div class="text-white"><i class="oi oi-chevron-right"></i></div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="me-3">
                            <div class="text-dark-50 small">Low Stock Alert</div>
                            <div class="text-lg fw-bold">12 Items</div>
                        </div>
                        <i class="oi oi-warning fs-1 opacity-25"></i>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small text-dark">
                    <a class="text-dark stretched-link" href="#">Check Inventory</a>
                    <div class="text-dark"><i class="oi oi-chevron-right"></i></div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-danger text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="me-3">
                            <div class="text-white-50 small">Out of Stock</div>
                            <div class="text-lg fw-bold">3 Items</div>
                        </div>
                        <i class="oi oi-circle-x fs-1 opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small">
                    <a class="text-white stretched-link" href="#">Restock Now</a>
                    <div class="text-white"><i class="oi oi-chevron-right"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-light">
                    <i class="oi oi-list me-1"></i>
                    Recent Products Added
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Product Name</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-3">Gaming Laptop X1</td>
                                <td>Electronics</td>
                                <td>$1,200.00</td>
                                <td><span class="badge bg-success">In Stock</span></td>
                            </tr>
                            <tr>
                                <td class="ps-3">Wireless Mouse</td>
                                <td>Accessories</td>
                                <td>$25.00</td>
                                <td><span class="badge bg-success">In Stock</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-light">
                    <i class="oi oi-bolt me-1"></i>
                    Quick Actions
                </div>
                <div class="card-body d-grid gap-2">
                    <button class="btn btn-outline-primary text-start"><i class="oi oi-plus me-2"></i> Add New Product</button>
                    <button class="btn btn-outline-secondary text-start"><i class="oi oi-print me-2"></i> Generate Report</button>
                    <button class="btn btn-outline-dark text-start"><i class="oi oi-person me-2"></i> User Settings</button>
                </div>
            </div>
        </div>
    </div>
</div>