<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4" style="width: 30%">Category Name</th>
                    <th style="width: 15%">Status</th>
                    <th style="width: 15%">Products</th>
                    <th style="width: 25%">Last Update</th>
                    <th class="text-end pe-4" style="width: 15%">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Categories != null && Categories.Any())
                {
                    @foreach (var cat in Categories)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold text-dark">@cat.Name</span>
                            </td>
                            <td>
                                @if (cat.IsActive)
                                {
                                    <span class="badge rounded-pill bg-success-subtle text-success border border-success px-3">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary px-3">Inactive</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@cat.ProductsCount Products</span>
                            </td>
                            <td>
                                <div class="d-flex flex-column">
                                    <small class="text-muted">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @(cat.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? cat.CreatedAt.ToString("dd/MM/yyyy HH:mm"))
                                    </small>
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm">
                                    <button class="btn btn-sm btn-white border"
                                            @onclick="() => OnToggleStatus.InvokeAsync(cat)"
                                            title="@(cat.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(cat.IsActive ? "bi-toggle-on text-success" : "bi-toggle-off text-muted") fs-5"></i>
                                    </button>

                                    <button class="btn btn-sm btn-white border"
                                            @onclick="() => OnEdit.InvokeAsync(cat)">
                                        <i class="bi bi-pencil-square text-primary"></i>
                                    </button>
                                    <button class="btn btn-sm btn-white border"
                                            disabled="@(cat.ProductsCount > 0)"
                                            @onclick="() => OnDelete.InvokeAsync(cat)"
                                            title="@(cat.ProductsCount > 0 ? "Cannot delete: Category has products" : "Delete Category")">
                                        <i class="bi bi-trash @(cat.ProductsCount > 0 ? "text-muted" : "text-danger")"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                            No categories found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter,EditorRequired] public IEnumerable<CategoryListDTO> Categories { get; set; } 
    [Parameter,EditorRequired] public EventCallback<CategoryListDTO> OnEdit { get; set; }
    [Parameter,EditorRequired] public EventCallback<CategoryListDTO> OnDelete { get; set; }
    [Parameter,EditorRequired] public EventCallback<CategoryListDTO> OnToggleStatus { get; set; }
}