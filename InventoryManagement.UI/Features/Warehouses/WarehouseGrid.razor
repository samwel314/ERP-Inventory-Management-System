<div class="card shadow-sm border-0 rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted">
                <tr>
                    <th class="ps-4 py-3 w-25">Warehouse Info</th>
                    <th class="py-3 text-center">Status</th>
                    <th class="py-3">City</th>
                    <th class="py-3 w-25">Address</th>
                    <th class="py-3">Last Update</th>
                    <th class="text-end pe-4 py-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Warehouses != null && Warehouses.Any())
                {
                    @foreach (var wh in Warehouses)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="p-2 bg-primary bg-opacity-10 rounded me-3">
                                        <i class="bi bi-house-door text-primary"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@wh.Name</span>
                                </div>
                            </td>
                            <td class="text-center">
                                @if (wh.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success px-3">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary px-3">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-geo-alt text-danger me-1"></i>
                                    @wh.City
                                </div>
                            </td>
                            <td>
                                <small class="text-muted d-inline-block text-wrap" style="max-width: 200px;">
                                    @(string.IsNullOrEmpty(wh.Address) ? "N/A" : wh.Address)
                                </small>
                            </td>
                            <td>
                                <small class="text-dark d-block">
                                    <i class="bi bi-calendar3 me-1 text-muted"></i>
                                    @(wh.UpdatedAt?.ToString("dd/MM/yyyy") ?? wh.CreatedAt.ToString("dd/MM/yyyy"))
                                </small>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <button class="btn btn-outline-secondary btn-sm"
                                            @onclick="() => OnToggleStatus.InvokeAsync(wh)">
                                        <i class="bi @(wh.IsActive ? "bi-toggle-on text-success" : "bi-toggle-off")"></i>
                                    </button>
                                    <button class="btn btn-outline-primary btn-sm"
                                            @onclick="() => OnEdit.InvokeAsync(wh)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No warehouses found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@code {
    [Parameter, EditorRequired] public IEnumerable<WarehouseDetailsDTO>? Warehouses { get; set; }
    [Parameter] public EventCallback<WarehouseDetailsDTO> OnEdit { get; set; } 
    [Parameter] public EventCallback<WarehouseDetailsDTO> OnToggleStatus { get; set; } 

}