<div class="modal show d-block shadow-lg" style="background: rgba(0,0,0,0.4)">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="oi oi-barcode me-2"></i> Inventory & SKU Details</h5>
                <button type="button" class="btn-close btn-close-white"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold small text-uppercase">SKU / Serial Number</label>
                        <input type="text" class="form-control bg-light fw-mono" placeholder="e.g., WH-102-BLU-S" />
                        <small class="text-muted">Unique identifier for this product variant.</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold small">MINIMUM LEVEL (Alert)</label>
                        <input type="number" class="form-control border-warning" placeholder="5" />
                        <div class="form-text text-warning small">System will alert at this level.</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold small">MAXIMUM LEVEL</label>
                        <input type="number" class="form-control" placeholder="100" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold small">DEFAULT STORAGE LOCATION</label>
                        <select class="form-select">
                            <option>Main Warehouse (A1)</option>
                            <option>Secondary Warehouse (B5)</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button class="btn btn-secondary px-4">Close</button>
                <button class="btn btn-dark px-4">Update SKU Info</button>
            </div>
        </div>
    </div>
</div>