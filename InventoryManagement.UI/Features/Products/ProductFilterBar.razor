@inject NavigationManager NavManager
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="oi oi-magnifying-glass"></i>
                    </span>
                    <input type="text" @bind="ProductSearchFilter.SearchTerm" class="form-control border-start-0" placeholder="Search by SKU or Product Name..." />
                </div>
            </div>
            <div class="col-md-3">
                <select @bind="ProductSearchFilter.CategoryId"  class="form-select text-muted">
                    <option value="" selected>All Categories</option>
                    @if (categories != null)
                    {
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <select @bind="IsActive"  class="form-select text-muted">
                    <option value="" selected>Status: All</option>
                    <option value="true">Active Only</option>
                    <option value="false">Archived</option>
                </select>
            </div>

            <div class="col-md-2">
                <button @onclick="OnApplyFilter" class="btn btn-outline-primary w-100">
                    <i class="oi oi-funnel me-1"></i> Apply Filter
                </button>
            </div>
        </div>
    </div>
</div>
<div class="row align-items-center mt-3">
    <div class="col-md-3 d-flex align-items-center">
        <label class="me-2 text-muted">Show:</label>
        <select @bind="ProductSearchFilter.PageSize"  class="form-select form-select-sm w-auto">
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>
        </select>
    </div>
    <div class="col-md-9 d-flex justify-content-end">
        <nav>
            <ul class="pagination pagination-sm mb-0">
                @if (ProductSearchFilter.Previous == 0)
                {
                    <li class="page-item"><button disabled class="page-link">Previous</button></li>
                }
                else
                {
                    <li class="page-item"><button @onclick="@(async () => await GoToPage(ProductSearchFilter.PageNumber - 1))" class="page-link">Previous</button></li>
                }
                @for (int i = 1; i <= ProductSearchFilter.TotalPages ; i ++)
                {
                    var pageNumber = i;
                    <li class="page-item  @(ProductSearchFilter.PageNumber == i ? "active" : "")"><button @onclick="@(async () => await GoToPage(pageNumber))" class="page-link">@i</button></li>
                }
                @if (ProductSearchFilter.Next == 0)
                {
                    <li class="page-item"><button disabled class="page-link">Next</button></li>
                }
                else
                {
                    <li class="page-item"><button @onclick="@(async () => await GoToPage(ProductSearchFilter.PageNumber + 1))" class="page-link">Next</button></li>
                }
            </ul>
        </nav>
    </div>
</div>
@code{
    private string IsActive = "" ; 
    [Parameter , EditorRequired]
    public ProductSearchFilter ProductSearchFilter { get; set; }
    [Parameter, EditorRequired]
    public IEnumerable<CategoryDTO> categories { get; set; }


    private async Task OnApplyFilter ()
    {
        if (string.IsNullOrEmpty(IsActive))
            ProductSearchFilter.IsActive = null ; 
        else
            ProductSearchFilter.IsActive = IsActive == "true";
        ProductSearchFilter.PageNumber = 1 ; 
        var queryParams = new Dictionary<string, object?>

        {
            [nameof(ProductSearchFilter.SearchTerm)] = ProductSearchFilter.SearchTerm,
            [nameof(ProductSearchFilter.CategoryId)] = ProductSearchFilter.CategoryId ,
            [nameof(ProductSearchFilter.IsActive)] = ProductSearchFilter.IsActive,
            [nameof(ProductSearchFilter.PageSize)] = ProductSearchFilter.PageSize,
            [nameof(ProductSearchFilter.PageNumber)] = ProductSearchFilter.PageNumber,
        };
        
        var newUri = NavManager.GetUriWithQueryParameters(queryParams);
        NavManager.NavigateTo(newUri);
    }
    async Task  GoToPage (int page )
    {
        ProductSearchFilter.PageNumber = page;

        var queryParams = new Dictionary<string, object?>

        {
            [nameof(ProductSearchFilter.SearchTerm)] = ProductSearchFilter.SearchTerm,
            [nameof(ProductSearchFilter.CategoryId)] = ProductSearchFilter.CategoryId,
            [nameof(ProductSearchFilter.IsActive)] = ProductSearchFilter.IsActive,
            [nameof(ProductSearchFilter.PageSize)] = ProductSearchFilter.PageSize,
            [nameof(ProductSearchFilter.PageNumber)] = ProductSearchFilter.PageNumber,
        };
        
        var newUri = NavManager.GetUriWithQueryParameters(queryParams);
        NavManager.NavigateTo(newUri);
    }
} 