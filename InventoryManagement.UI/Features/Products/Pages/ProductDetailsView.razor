@if (Product != null)
{
    <div class="card border-0 shadow-sm">
        <div class="text-center bg-light p-4 rounded mb-3">
            <img src="@Product.ImageUrl" class="img-fluid rounded shadow-sm" style="max-height: 200px;" alt="@Product.Name">
            <h4 class="mt-3 mb-1 fw-bold text-primary">@Product.Name</h4>
            <span class="badge @(Product.IsActive ? "bg-success" : "bg-secondary")">
                @(Product.IsActive ? "Active" : "Archived")
            </span>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6">
                <div class="p-3 border rounded bg-white">
                    <small class="text-muted d-block">Selling Price</small>
                    <strong class="fs-5 text-success">@Product.SellingPrice.ToString("C")</strong>
                </div>
            </div>
            <div class="col-6">
                <div class="p-3 border rounded bg-white">
                    <small class="text-muted d-block">Profit/Unit</small>
                    <strong class="fs-5 text-info">@Product.ProfitPerUnit.ToString("C")</strong>
                </div>
            </div>
        </div>

        <ul class="list-group list-group-flush border-top">
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-muted">SKU</span>
                <span class="fw-medium">@Product.SKU</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-muted">Category</span>
                <span class="badge bg-light text-dark border">@Product.CategoryName</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-muted">Min. Stock Level</span>
                <span class="text-danger fw-bold">@Product.MinimumStock</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-muted">Added On</span>
                <span>@Product.CreatedAt.ToShortDateString()</span>
            </li>
        </ul>

        <div class="mt-4">
            <h6 class="fw-bold">Description</h6>
            <p class="text-muted small">@Product.Description</p>
        </div>
    </div>
}

@code {
    [Parameter , EditorRequired] public ProductDetailsDTO Product { get; set; }
}