@page "/products"
<div class="container-fluid p-4 bg-light min-vh-100">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-navy">Inventory Management</h3>
        <a href="/products/add" class="btn btn-primary shadow-sm px-4">
            <i class="oi oi-plus me-2"></i> Add New Product
        </a>
    </div>

    @*     <ProductSummaryCards />
 *@
    <ProductFilterBar OnApplyFilterRequested="LoadData"  categories="Categories" ChangeCategory="ChangeCategory" ChangeActive="ChangeActive" ProductSearchFilter="productSearchFilter" ChangePage="ChangePage" ChangePageSize="ChangePageSize" />

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <ProductDataGrid products="products" />
        </div>
    </div>
</div>

@* <PricingUpdateModal /> *@
@* <SkuUpdateModal /> *@
@code
{
    [Inject]
    public HttpClient? ProductHttpClient { get; set; }
    private ProductSearchFilter productSearchFilter = new();
    private PagedResult<ProductListDTO>? pagedResult;
    private IEnumerable<ProductListDTO>? products;
    private IEnumerable<CategoryDTO> ? Categories  ; 

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        Categories = await ProductHttpClient!.
        GetFromJsonAsync<IEnumerable<CategoryDTO>>
        ($"{UrlsPath.BaseUrl}{UrlsPath.Categories}") ; 

    }
    private async Task LoadData()
    {
        List<string> query = new List<string>();

        query.Add($"page={productSearchFilter.PageNumber}");
        query.Add($"pageSize={productSearchFilter.PageSize}");

        if (productSearchFilter.CategoryId.HasValue)
        {
            query.Add($"categoryId={productSearchFilter.CategoryId}");
        }
        if (!string.IsNullOrWhiteSpace(productSearchFilter.SearchTerm))
        {
            query.Add($"searchTerm={productSearchFilter.SearchTerm}");
        }
        if (productSearchFilter.IsActive.HasValue)
        {
            query.Add($"active={productSearchFilter.IsActive}");
        }
        var fullQuery = string.Join("&" , query) ;
        Console.WriteLine(fullQuery);
        pagedResult =
        await ProductHttpClient!.
        GetFromJsonAsync<PagedResult<ProductListDTO>>
        ($"{UrlsPath.BaseUrl}{UrlsPath.Products}?{fullQuery}");
        if (pagedResult != null)
        {
            products = pagedResult.Items;
            productSearchFilter.Next = pagedResult.Next;
            productSearchFilter.Previous = pagedResult.Previous;
            productSearchFilter.TotalPages = pagedResult.TotalPages;
            query.Clear(); 
        }

    }
    private async Task ChangePage(int page)
    {
        productSearchFilter.PageNumber = page;
        await LoadData();
    }
    private async Task ChangeCategory(int? categoryId)
    {
        productSearchFilter.CategoryId = categoryId;
        productSearchFilter.PageNumber = 1; 
        await LoadData();
    }
    private async Task ChangeActive(bool ? isActive)
    {
        productSearchFilter.IsActive = isActive;
        productSearchFilter.PageNumber = 1;
        await LoadData();
    }
    private async Task ChangePageSize(int pageSize)
    {
        productSearchFilter.PageSize = pageSize;
        productSearchFilter.PageNumber = 1; 
        await LoadData();
    }

}