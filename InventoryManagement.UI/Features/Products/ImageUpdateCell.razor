<div class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex align-items-center justify-content-center"
     style="z-index: 1050;" @onclick="OnCancel">
    
    <div class="card shadow-lg border-0 p-3 bg-white rounded-3 animate__animated animate__fadeInDown"
         style="min-width: 400px;" @onclick:stopPropagation>
        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-primary">Update product image </h6>
            <button type="button" class="btn-close small" @onclick="OnCancel"></button>
        </div>

        <div class="card-body py-4">
            <div class="d-flex flex-column align-items-center gap-3">
                <div class="position-relative">
                    <img src="@(UrlsPath.Host + product.ImageUrl)"
                         class="rounded-circle border shadow-sm"
                         style="width: 100px; height: 100px; object-fit:cover;" />
                    <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-secondary border border-light">Current</span>
                </div>

                <EditForm Model="updateProductImageUiDTO" OnValidSubmit="SaveImage" class="w-100">
                    <FluentValidationValidator />

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Select new image</label>
                        <InputFile OnChange="HandleChange" class="form-control form-control-sm" />
                        <ValidationMessage For="@(() => updateProductImageUiDTO.Image)" class="text-danger small mt-1" />
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-sm btn-light px-4" @onclick="OnCancel">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary px-4 shadow-sm">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProductListDTO product { get; set; }
    [Parameter, EditorRequired] public EventCallback<UpdateProductImageUiDTO> ChangeImage { get; set; }
    [Parameter, EditorRequired] public EventCallback Cancel { get; set; }

    UpdateProductImageUiDTO updateProductImageUiDTO = new UpdateProductImageUiDTO();

    private void HandleChange(InputFileChangeEventArgs e)
    {
        updateProductImageUiDTO.Image = e.File;
        updateProductImageUiDTO.Id = product.Id;
    }

    private async Task SaveImage()
    {
        await ChangeImage.InvokeAsync(updateProductImageUiDTO);
        ResetDto();
    }

    private async Task OnCancel()
    {
        ResetDto();
        await Cancel.InvokeAsync();
    }

    private void ResetDto()
    {
        updateProductImageUiDTO = new UpdateProductImageUiDTO();
        StateHasChanged();
    }
}